# Copy this file to `.env` and fill it in — copy, do not rename, so this template
# stays in the repository. `.env` is gitignored and must never be committed.

# Required only for live LLM-driven discovery (`--planner claude`).
# Everything else runs without it, including the full test suite and the whole
# demo path via `--planner scripted`.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# Entry point of the synthetic target application started by `cua serve`.
TARGET_BASE_URL=http://127.0.0.1:8000/legacy

# Optional. Playwright's bundled Chromium fails to launch on some Windows installs
# ("side-by-side configuration is incorrect"). Set this to a browser you already
# have to use that instead. Leave unset on macOS and Linux.
# PLAYWRIGHT_CHANNEL=msedge

# Optional. Milliseconds to pause between browser actions so a headed run can be
# followed by a human. Demo aid only; leave unset in normal operation.
# PLAYWRIGHT_SLOW_MO=1500
